{
  "name": "aurasound",
  "version": "1.0.6",
  "description": "AuraSound - Hi-Fi Music Hub & Suno AI Music Studio",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "dist": "electron-builder --win"
  },
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/BizleeRav/Project-Aplikasi-Music.git"
  },
  "type": "commonjs",
  "dependencies": {
    "@braccato/core": "^1.16.13",
    "@braccato/parsers": "^0.4.0",
    "@distube/ytdl-core": "^5.0.1",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "kpop": "^0.1.2",
    "kuroshiro": "^1.2.1",
    "kuroshiro-analyzer-kuromoji": "^1.1.0",
    "pinyin-pro": "^3.29.5",
    "play-dl": "^1.9.7",
    "qrcode": "^1.5.4",
    "wanakana": "^5.3.1",
    "youtube-sr": "^4.3.12",
    "youtubei.js": "^18.2.0",
    "yt-search": "^2.13.1",
    "ytpl": "^2.3.0"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "6b30c8dc-bf3b-56dd-9dfd-90f36a49d254",
    "productName": "AuraSound",
    "publish": [
      {
        "provider": "github",
        "owner": "BizleeRav",
        "repo": "Project-Aplikasi-Music"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "dist/.icon-ico/icon.ico",
      "artifactName": "AuraSound Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false
    },
    "files": [
      "**/*",
      "!**/.env*",
      "!**/*.log",
      "!data/**",
      "!scratch/**",
      "!.git/**",
      "!.vercel/**",
      "!dist/**",
      "!release/**",
      "!android-build/**",
      "!android-keystore/**",
      "!**/*.bak"
    ]
  }
}
